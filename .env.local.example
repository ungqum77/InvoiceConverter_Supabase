# Supabase 접속 정보 (Supabase → Project Settings → API)
# 공개용 키는 sb_publishable_... (신규) 또는 eyJ... (구형 anon) 둘 다 됩니다.
# 이 파일을 복사해서 `.env.local` 로 이름을 바꾼 뒤 값을 채우세요.
# .env.local 은 .gitignore 에 들어있어 GitHub에 올라가지 않습니다.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...여기에_공개키...

# 선택: Gemini 기능을 쓸 때만 필요
# GEMINI_API_KEY=
